# Qihoo 360T7 / Kwrt 25.12 build configuration
# Keep both official 25.12 profiles for partition-layout verification.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7-ubi=y

# Keep the traditional opkg/IPK package format.
CONFIG_USE_APK=n

# Minimal LuCI base; do not add nginx to the small NAND image.
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y

# Build HomeProxy and sing-box as installable packages, not in the firmware image.
CONFIG_PACKAGE_luci-app-homeproxy=m
CONFIG_PACKAGE_sing-box=m

# Useful base utilities.
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_zoneinfo-asia=y

# The official 360T7 device profile supplies its required MTK wireless packages.
